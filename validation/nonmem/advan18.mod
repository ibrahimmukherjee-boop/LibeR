;DDE
$PROBLEM LibeR ADVAN18 DDE_SOLVER prediction validation
$INPUT ID TIME EVID AMT RATE CMT DV MDV
$DATA advan18.dat
$SUBROUTINES ADVAN18 TOL=9
$MODEL COMP=(CENTRAL DEFDOSE DEFOBSERVATION)
$PK
K=THETA(1)*EXP(ETA(1))
FB=THETA(2)
TAU1=THETA(3)
S1=THETA(4)
$DES
AP_1_1=0
DADT(1)=-K*A(1)+FB*AD_1_1
$ERROR
IPRED=F
Y=F+EPS(1)
$THETA 0.4 FIX
$THETA 0.08 FIX
$THETA 2 FIX
$THETA 20 FIX
$OMEGA 0 FIX
$SIGMA 1 FIX
$ESTIMATION MAXEVAL=0 NOABORT
$TABLE ID TIME EVID AMT CMT IPRED NOPRINT ONEHEADER FORMAT=s1PE15.8 FILE=advan18.tab
