;DDE
$PROBLEM LibeR ADVAN17 equivalent DDE_SOLVER reference validation
$INPUT ID TIME EVID AMT RATE CMT DV MDV
$DATA advan17eqv.dat
$SUBROUTINES ADVAN18 TOL=9
$MODEL COMP=(CENTRAL DEFDOSE DEFOBSERVATION)
$PK
KFREE=THETA(1)*EXP(ETA(1))
FBFREE=THETA(2)
TAU1=THETA(3)
S1=THETA(4)
$DES
AP_1_1=0
DADT(1)=-KFREE*A(1)+FBFREE*AD_1_1
$ERROR
IPRED=F
Y=F+EPS(1)
$THETA 0.2 FIX
$THETA 0.04 FIX
$THETA 2 FIX
$THETA 20 FIX
$OMEGA 0 FIX
$SIGMA 1 FIX
$ESTIMATION MAXEVAL=0 NOABORT
$TABLE ID TIME EVID AMT CMT IPRED NOPRINT ONEHEADER FORMAT=s1PE15.8 FILE=advan17eqv.tab
