;DDE
$PROBLEM LibeR ADVAN17 delayed-equilibrium prediction validation
$INPUT ID TIME EVID AMT RATE CMT DV MDV
$DATA advan17.dat
$SUBROUTINES ADVAN17 TOL=9
$MODEL
COMP=(CENTRAL DEFDOSE DEFOBSERVATION)
COMP=(FREE EQUILIBRIUM)
$PK
K=THETA(1)*EXP(ETA(1))
FB=THETA(2)
TAU1=THETA(3)
BIND=THETA(4)
S1=THETA(5)
$DES
AP_1_1=0
DADT(1)=-K*A(2)+FB*AD_1_1
$AESINIT
INIT=0
$AES
E(2)=A(2)-A(1)/(1+BIND)
$ERROR
IPRED=F
Y=F+EPS(1)
$THETA 0.4 FIX
$THETA 0.08 FIX
$THETA 2 FIX
$THETA 1 FIX
$THETA 20 FIX
$OMEGA 0 FIX
$SIGMA 1 FIX
$ESTIMATION MAXEVAL=0 NOABORT
$TABLE ID TIME EVID AMT CMT IPRED NOPRINT ONEHEADER FORMAT=s1PE15.8 FILE=advan17.tab
